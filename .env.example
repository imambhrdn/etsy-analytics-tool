# Etsy Intelligence — contoh environment variables.
# Salin ke `.env.local` dan isi nilainya. JANGAN commit `.env.local`.
# Jangan pernah menempelkan rahasia ke chat, log, atau dokumentasi (PRD §12, §19).

# --- App ---
# Zona waktu tampilan (default Asia/Jakarta)
APP_TIMEZONE=Asia/Jakarta

# --- Supabase ---
# URL & anon key aman untuk client (dibundel). Service role HANYA server.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# server-only — jangan pernah dipakai di browser
SUPABASE_SERVICE_ROLE_KEY=

# --- Etsy Open API v3 ---
# x-api-key = "keystring:shared_secret" (keduanya dari https://www.etsy.com/developers/your-apps)
ETSY_API_KEY=
ETSY_SHARED_SECRET=
# Harus HTTPS dan match persis dengan callback URL terdaftar (PRD §7.6)
ETSY_REDIRECT_URI=

# --- Keamanan token OAuth ---
# Kunci enkripsi untuk access/refresh token yang disimpan di DB
TOKEN_ENCRYPTION_KEY=

# --- n8n (server-only) ---
N8N_BASE_URL=
N8N_WEBHOOK_SECRET=

# --- AI (opsional) ---
AI_PROVIDER_API_KEY=
